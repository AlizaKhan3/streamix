# Copy this file to .env and fill in real values before running.

PORT=4000
JWT_SECRET=streamix-dev-jwt-secret-change-me
INTERNAL_SECRET=streamix-dev-internal-secret-change-me

# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# --- USER DB (primary/replica) ---
USER_DB_MASTER_HOST=localhost
USER_DB_MASTER_PORT=5501
USER_DB_REPLICA_HOST=localhost
USER_DB_REPLICA_PORT=5502
USER_DB_NAME=user_db
USER_DB_USER=app
USER_DB_PASSWORD=app_pass

# --- MOVIE SHARD 0 - US region ---
MOVIE_SHARD0_MASTER_HOST=localhost
MOVIE_SHARD0_MASTER_PORT=5411
MOVIE_SHARD0_REPLICA_HOST=localhost
MOVIE_SHARD0_REPLICA_PORT=5412
MOVIE_SHARD0_REGION=US

# --- MOVIE SHARD 1 - EU region ---
MOVIE_SHARD1_MASTER_HOST=localhost
MOVIE_SHARD1_MASTER_PORT=5421
MOVIE_SHARD1_REPLICA_HOST=localhost
MOVIE_SHARD1_REPLICA_PORT=5422
MOVIE_SHARD1_REGION=EU

MOVIE_DB_NAME=movie_db
MOVIE_DB_USER=app
MOVIE_DB_PASSWORD=app_pass

# --- WATCHLIST SHARDS ---
WATCHLIST_SHARD0_HOST=localhost
WATCHLIST_SHARD0_PORT=5431
WATCHLIST_SHARD1_HOST=localhost
WATCHLIST_SHARD1_PORT=5432
WATCHLIST_DB_NAME=watchlist_db
WATCHLIST_DB_USER=app
WATCHLIST_DB_PASSWORD=app_pass

# --- REVIEW SHARDS ---
REVIEW_SHARD0_HOST=localhost
REVIEW_SHARD0_PORT=5441
REVIEW_SHARD1_HOST=localhost
REVIEW_SHARD1_PORT=5442
REVIEW_DB_NAME=review_db
REVIEW_DB_USER=app
REVIEW_DB_PASSWORD=app_pass
