{
  "name": "ddb-movie-streaming-backend",
  "version": "2.0.0",
  "description": "Distributed Movie Streaming Database - regional API gateways, fragment router, 2PC/Saga, geo-replication",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "start:pk": "node src/index.js --region=PK --port=4001 --db-mode=host",
    "start:us": "node src/index.js --region=US --port=4002 --db-mode=host",
    "seed": "node scripts/seed.js --db-mode=host",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
